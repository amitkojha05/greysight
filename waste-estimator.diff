+def estimate_warehouse_waste(
+    warehouse_spend_daily: list[WarehouseSpendDaily | dict[str, Any]],
+    *,
+    current_usage_date: date,
+    window_days: int,
+) -> list[WarehouseWasteEstimate]:
+    """Per-warehouse recoverable idle credits over the complete billing window.
+
+    ``idle = credits_used_compute - credits_attributed_queries`` (mirrors
+    ``_warehouse_idle_pct`` in ``dashboard_view_builder``). Any row missing
+    ``credits_attributed_queries`` (adaptive warehouses on old Account Usage
+    schemas) collapses the whole warehouse's ``idle_pct`` to ``None`` —
+    partial attribution is less honest than an em dash.
+
+    Returns rows sorted by ``idle_credits`` descending, then warehouse name
+    ascending for stable output. Warehouses with zero compute in the window
+    are dropped — they cannot waste what they did not spend.
+
+    Fail-loud: ``compute < 0`` or ``attributed > compute + eps`` raise, matching
+    ``_warehouse_row_dollars``. Never silently clamp real negatives.
+    """
+    complete_start, complete_end = _complete_window_bounds(
+        current_usage_date=current_usage_date,
+        window_days=window_days,
+    )
+    rows = [
+        WarehouseSpendDailyWithAttribution.model_validate(row)
+        for row in warehouse_spend_daily
+    ]
+    rows = _filter_complete_window(
+        rows,
+        start_date=complete_start,
+        end_date=complete_end,
+    )
+
+    compute_by_wh: dict[str, float] = defaultdict(float)
+    attributed_by_wh: dict[str, float | None] = {}
+    for row in rows:
+        if row.credits_used_compute < 0.0:
+            raise ValueError(
+                "warehouse_spend_daily credits_used_compute must be >= 0"
+            )
+        compute_by_wh[row.warehouse_name] += row.credits_used_compute
+        current = attributed_by_wh.get(row.warehouse_name, 0.0)
+        if current is None or row.credits_attributed_queries is None:
+            attributed_by_wh[row.warehouse_name] = None
+        else:
+            attributed_by_wh[row.warehouse_name] = (
+                current + row.credits_attributed_queries
+            )
+
+    estimates: list[WarehouseWasteEstimate] = []
+    for warehouse_name, compute in compute_by_wh.items():
+        if compute <= 0.0:
+            continue
+        attributed = attributed_by_wh.get(warehouse_name)
+        if attributed is None:
+            estimates.append(
+                WarehouseWasteEstimate(
+                    warehouse_name=warehouse_name,
+                    idle_credits=0.0,
+                    idle_pct=None,
+                )
+            )
+            continue
+        idle = compute - attributed
+        _EPS = 1e-9
+        if idle < -_EPS:
+            raise ValueError(
+                "warehouse_spend_daily credits_used_compute must be "
+                ">= credits_attributed_queries"
+            )
+        idle = max(idle, 0.0)
+        estimates.append(
+            WarehouseWasteEstimate(
+                warehouse_name=warehouse_name,
+                idle_credits=idle,
+                idle_pct=idle / compute,
+            )
+        )
+    return sorted(
+        estimates,
+        key=lambda est: (-est.idle_credits, est.warehouse_name),
+    )
